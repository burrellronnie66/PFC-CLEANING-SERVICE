# ============================================================
# PFC CLEANING SERVICE — QUOTE FORM DELIVERY
# Copy this file to .env.local for local development, or set
# these in your host's environment settings (e.g. Vercel →
# Project → Settings → Environment Variables) in production.
# NEVER commit .env.local or real keys to the repository.
# ============================================================

# Delivery provider: log | formspree | resend | webhook
# The site currently defaults to "formspree" with the form ID set in
# src/config/site.ts — no env vars are required for that setup.
# Set variables here only to OVERRIDE the defaults.
#QUOTE_PROVIDER=formspree

# --- Option A: Formspree (current setup) --------------------
# The form ID is the part after /f/ in your endpoint URL.
# Only set this to switch to a different Formspree form.
#QUOTE_FORMSPREE_ID=yourFormId

# --- Option B: Resend (transactional email) -----------------
# 1. Create an API key at https://resend.com
# 2. Verify your sending domain (e.g. pfcservice.net)
#QUOTE_PROVIDER=resend
#QUOTE_RESEND_API_KEY=re_xxxxxxxxxxxx
#QUOTE_TO_EMAIL=you@example.com
#QUOTE_FROM_EMAIL=quotes@pfcservice.net

# --- Option C: Webhook (GoHighLevel / Zapier / Make / CRM) --
# Paste an inbound webhook URL; the full form payload is POSTed
# to it as JSON.
#QUOTE_PROVIDER=webhook
#QUOTE_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/xxxx
